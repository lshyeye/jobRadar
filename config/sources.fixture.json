      "id": "src_a",
      "name": "数据源 A（离线快照）",
      "adapter": "fixture",
      "enabled": true,
      "config": {
        "detailInList": true,
        "fieldMap": {
          "title": "jobName",
          "company": "companyName",
          "city": "workCity",
          "salaryMin": "salaryMin",
